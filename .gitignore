# Plugin runtime artifacts (per-loop, never committed).
# Anchored paths so they don't hide similarly-named files inside the plugin
# code (like commands/plan.md). The ** pattern catches runtime state created
# by tests that cd into nested directories.
/.claude/claudex/
**/.claude/claudex/
/PLAN.md
/reviews/

# Editor/OS noise
.DS_Store
*.swp
*.swo
*~
.idea/
.vscode/

# Test scratch
/tmp/

# Python
__pycache__/
*.pyc

# seed/ run artifacts: prediction ledgers are ~35MB each and model checkpoints
# are regenerable. The committed run.json + summary.json + ledger_manifest.json
# (record count + terminal hash of each chain) preserve every claim; the raw
# ledgers reproduce exactly from `run_experiment.py` at the same seeds.
seed/results/**/ledger.jsonl
seed/results/**/model.pt
seed/results/**/*.log
seed/results/archive_v1/
